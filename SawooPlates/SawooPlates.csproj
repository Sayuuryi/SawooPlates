<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <!-- Manifest -->
  <PropertyGroup>
    <Version>0.9.1.0</Version>
    <Name>Sawoo Plates</Name>
    <Author>Sayuuryi</Author>
    <Punchline>A few extra tools for the Portrait Editor.</Punchline>
    <!-- Fixed text shown in the plugin installer. Keep it as is across updates. -->
    <Description>Adds a small menu bar to the Portrait Editor with preset codes, a preset library and finer camera controls.</Description>
    <RepoUrl>https://github.com/Sayuuryi/SawooPlates</RepoUrl>
    <IconUrl>https://raw.githubusercontent.com/Sayuuryi/SawooPlates/main/SawooPlates/Assets/icon.png</IconUrl>
    <Tags>portrait;portrait editor;preset;banner</Tags>
  </PropertyGroup>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="TerraFX.Interop.Windows" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SawooPlates.Core\SawooPlates.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Translations.json" LogicalName="SawooPlates.Translations.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\icon.png" Link="images\icon.png" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
